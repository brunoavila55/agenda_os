# Copie para .env e troque todos os valores marcados como CHANGE_ME.
APP_MODE=simulation
APP_TIMEZONE=America/Sao_Paulo
APP_API_TOKEN=CHANGE_ME_use_um_token_longo
APP_PASSWORD=CHANGE_ME_use_uma_senha_forte
SESSION_SECRET=CHANGE_ME_minimo_32_caracteres_use_valor_aleatorio
# Use true quando o painel estiver publicado atrás de HTTPS.
SESSION_COOKIE_SECURE=false

POSTGRES_DB=agenda_os
POSTGRES_USER=agenda_os
POSTGRES_PASSWORD=CHANGE_ME_database_password
DATABASE_URL=postgres://agenda_os:CHANGE_ME_database_password@db:5432/agenda_os?sslmode=disable

API_ADDR=:8080
API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_APP_NAME=Agenda O.S.
SYNC_INTERVAL=10m
WORKER_POLL_INTERVAL=3s

# Integração real permanece desabilitada enquanto os contratos pendentes não forem confirmados.
MK_RULE_BASE_URL=
MK_NODE_BASE_URL=
MK_INPUT_TOKEN=
MK_PASSWORD=
# cd_servico do perfil de Webservice autorizado para o serviço que será chamado
# (cada serviço do MK pode exigir um cd_servico diferente; não é um valor fixo).
MK_SERVICE_CODE=
# As três variáveis abaixo são exigidas em conjunto; deixe todas vazias para
# manter o agrupamento somente determinístico (padrão).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=
# Opcional; padrão 8s. Tempo máximo de espera pela resposta do Workers AI.
CLOUDFLARE_AI_TIMEOUT=8s
